---
import { Icon } from 'astro-icon/components';

interface Props {
  categories: { id: string; name: string }[];
  activeCategory?: string;
  activeSort?: string;
  slug: string;
  currency?: string;
}

const { categories, activeCategory, activeSort, slug, currency = 'PEN' } = Astro.props;

const sortOptions = [
  { value: '', label: 'Más recientes' },
  { value: 'price_asc', label: 'Precio: menor a mayor' },
  { value: 'price_desc', label: 'Precio: mayor a menor' },
  { value: 'name_asc', label: 'Nombre: A - Z' },
];
---

<div class="filter-bar">
  <div class="filter-row">
    <!-- Sort button -->
    <button id="sort-toggle" class="sort-toggle-btn" aria-label="Ordenar">
      <Icon name="lucide:arrow-up-down" class="w-4 h-4" />
    </button>

    <!-- Search button / expandable input -->
    <div id="search-wrapper" class="search-wrapper" data-slug={slug} data-api-url={import.meta.env.PUBLIC_API_URL || 'http://localhost:3000'} data-currency={currency}>
      <button id="search-toggle" class="search-btn" aria-label="Buscar">
        <Icon name="lucide:search" class="w-4 h-4" />
      </button>
      <input
        id="search-input"
        type="text"
        placeholder="Buscar productos..."
        class="search-input"
      />
      <button id="search-close" class="search-close" aria-label="Cerrar búsqueda">
        <Icon name="lucide:x" class="w-4 h-4" />
      </button>
    </div>

    <!-- Categories -->
    <div id="categories-row" class="categories-row">
      <a
        href={`/${slug}`}
        class:list={[
          'chip',
          !activeCategory && 'chip-active',
        ]}
      >
        Todos
      </a>
      {categories.map((cat) => (
        <a
          href={`/${slug}?category=${cat.id}`}
          class:list={[
            'chip',
            activeCategory === cat.id && 'chip-active',
          ]}
        >
          {cat.name}
        </a>
      ))}
    </div>
  </div>

  <!-- Sort dropdown (outside filter-row to avoid overflow clipping) -->
  <div id="sort-dropdown" class="sort-dropdown" style="display:none;">
    {sortOptions.map((opt) => (
      <button
        class:list={['sort-option', (activeSort || '') === opt.value && 'sort-option-active']}
        data-sort-value={opt.value}
      >
        {opt.label}
        {(activeSort || '') === opt.value && <Icon name="lucide:check" class="w-3.5 h-3.5" />}
      </button>
    ))}
  </div>
</div>

<style>
  .filter-bar {
    position: relative;
  }

  .filter-row {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .filter-row::-webkit-scrollbar {
    display: none;
  }

  .categories-row {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .categories-row::-webkit-scrollbar {
    display: none;
  }

  .categories-row.fade-right {
    mask-image: linear-gradient(to left, transparent 0%, black 8%);
    -webkit-mask-image: linear-gradient(to left, transparent 0%, black 8%);
  }

  .categories-row.fade-left {
    mask-image: linear-gradient(to right, transparent 0%, black 8%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%);
  }

  .categories-row.fade-left.fade-right {
    mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
  }

  .categories-row.hidden {
    opacity: 0;
    transform: translateX(10px);
    pointer-events: none;
    position: absolute;
  }

  .chip {
    padding: 8px 16px;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    transition: all 0.15s ease;
    text-decoration: none;
    background: color-mix(in srgb, var(--brand-color) 8%, transparent);
    color: var(--brand-color);
    border: 1px solid color-mix(in srgb, var(--brand-color) 25%, transparent);
  }

  .chip:hover {
    background: color-mix(in srgb, var(--brand-color) 15%, transparent);
  }

  .chip-active {
    background-color: color-mix(in srgb, var(--brand-color) 12%, transparent);
    border-color: color-mix(in srgb, var(--brand-color) 40%, transparent);
    color: var(--brand-color);
  }

  /* Search wrapper */
  .search-wrapper {
    display: flex;
    align-items: center;
    position: relative;
    height: 36px;
    min-width: 36px;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--brand-color) 40%, transparent);
    background: color-mix(in srgb, var(--brand-color) 12%, transparent);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
  }

  .search-wrapper.expanded {
    flex: 1;
  }

  .search-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    min-width: 36px;
    border: none;
    background: none;
    color: var(--brand-color);
    cursor: pointer;
    padding: 0;
  }

  .search-input {
    flex: 1;
    width: 0;
    border: none;
    outline: none;
    font-size: 0.875rem;
    background: transparent;
    color: var(--brand-color);
    padding: 0 8px 0 0;
    opacity: 0;
    transition: opacity 0.2s ease 0.1s;
  }

  .search-input::placeholder {
    color: color-mix(in srgb, var(--brand-color) 50%, transparent);
  }

  .search-wrapper.expanded .search-input {
    width: auto;
    opacity: 1;
  }

  .search-close {
    display: none;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    min-width: 32px;
    border: none;
    background: none;
    color: var(--brand-color);
    cursor: pointer;
    padding: 0;
    margin-right: 4px;
    border-radius: 50%;
    transition: background 0.15s ease;
  }

  .search-close:hover {
    background: color-mix(in srgb, var(--brand-color) 15%, transparent);
  }

  .search-wrapper.expanded .search-close {
    display: flex;
  }

  /* Sort */
  .sort-toggle-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    min-width: 36px;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--brand-color) 25%, transparent);
    background: color-mix(in srgb, var(--brand-color) 8%, transparent);
    color: var(--brand-color);
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.15s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .sort-toggle-btn:hover {
    background: color-mix(in srgb, var(--brand-color) 15%, transparent);
  }

  .sort-dropdown {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    z-index: 100;
    min-width: 200px;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 6px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    backdrop-filter: blur(12px);
  }

  @media (prefers-color-scheme: dark) {
    .sort-dropdown {
      background: #171717;
      border-color: #374151;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    }
  }

  .sort-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 10px 12px;
    border: none;
    background: transparent;
    border-radius: 8px;
    font-size: 0.85rem;
    color: #1f2937;
    cursor: pointer;
    text-align: left;
    transition: background 0.12s ease;
  }

  @media (prefers-color-scheme: dark) {
    .sort-option {
      color: #e5e7eb;
    }
  }

  .sort-option:hover {
    background: #f3f4f6;
  }

  @media (prefers-color-scheme: dark) {
    .sort-option:hover {
      background: #1f2937;
    }
  }

  .sort-option-active {
    color: var(--brand-color);
    font-weight: 600;
    background: color-mix(in srgb, var(--brand-color) 8%, transparent);
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    // Sort dropdown
    const sortToggle = document.getElementById('sort-toggle');
    const sortDropdown = document.getElementById('sort-dropdown');

    if (sortToggle && sortDropdown) {

      sortToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        e.preventDefault();
        const isHidden = sortDropdown.style.display === 'none' || !sortDropdown.style.display;
        sortDropdown.style.display = isHidden ? 'flex' : 'none';
      });

      document.addEventListener('click', () => {
        sortDropdown.style.display = 'none';
      });

      sortDropdown.addEventListener('click', (e) => {
        e.stopPropagation();
      });

      sortDropdown.querySelectorAll('.sort-option').forEach((btn) => {
        btn.addEventListener('click', () => {
          const value = (btn as HTMLElement).dataset.sortValue || '';
          const url = new URL(window.location.href);
          if (value) {
            url.searchParams.set('sort', value);
          } else {
            url.searchParams.delete('sort');
          }
          window.location.href = url.toString();
        });
      });
    } else {
      // Sort elements not found
    }

    // Search
    const wrapper = document.getElementById('search-wrapper');
    const toggle = document.getElementById('search-toggle');
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const close = document.getElementById('search-close');
    const categories = document.getElementById('categories-row');

    if (!wrapper || !toggle || !input || !close || !categories) return;

    function expand() {
      wrapper!.classList.add('expanded');
      categories!.classList.add('hidden');
      setTimeout(() => input!.focus(), 300);
    }

    function collapse() {
      wrapper!.classList.remove('expanded');
      categories!.classList.remove('hidden');
      input!.value = '';
      // Show all original products and remove search-generated ones
      let hasOriginalProducts = false;
      document.querySelectorAll('[data-product-name]').forEach((card) => {
        if ((card as HTMLElement).dataset.searchResult === 'true') {
          card.remove();
        } else {
          (card as HTMLElement).style.display = '';
          hasOriginalProducts = true;
        }
      });
      // Restore empty state if needed
      const emptyState = document.getElementById('products-empty');
      const grid = document.getElementById('products-grid');
      if (!hasOriginalProducts && emptyState && grid) {
        emptyState.classList.remove('hidden');
        grid.classList.add('hidden');
      }
    }

    toggle.addEventListener('click', () => {
      if (wrapper!.classList.contains('expanded')) return;
      expand();
    });

    close.addEventListener('click', collapse);

    input!.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') collapse();
    });

    // Search with debounce against API
    let searchTimeout: ReturnType<typeof setTimeout>;

    input!.addEventListener('input', () => {
      const query = input!.value.trim();

      // If empty, show all products
      if (!query) {
        document.querySelectorAll('[data-product-name]').forEach((card) => {
          (card as HTMLElement).style.display = '';
        });
        const resultsContainer = document.getElementById('search-results');
        if (resultsContainer) resultsContainer.classList.add('hidden');
        const mainGrid = document.querySelector('[data-product-name]')?.parentElement;
        if (mainGrid) (mainGrid as HTMLElement).style.display = '';
        return;
      }

      // Local filter immediately
      document.querySelectorAll('[data-product-name]').forEach((card) => {
        const name = (card as HTMLElement).dataset.productName?.toLowerCase() || '';
        (card as HTMLElement).style.display = (!query || name.toLowerCase().includes(query.toLowerCase())) ? '' : 'none';
      });

      // Debounced API search
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(async () => {
        const slug = wrapper!.dataset.slug || '';
        const apiUrl = wrapper!.dataset.apiUrl || '';
        if (!slug || !apiUrl || !query) return;

        try {
          const params = new URLSearchParams({ search: query });
          const res = await fetch(`${apiUrl}/api/v1/store/${slug}/products?${params}`);
          if (!res.ok) return;
          const json = await res.json();
          const products = json.data?.data ?? json.data ?? [];

          if (products.length === 0) {
            // Hide all cards if no results
            document.querySelectorAll('[data-product-name]').forEach((card) => {
              (card as HTMLElement).style.display = 'none';
            });
            return;
          }

          // Get the grid container
          const grid = document.getElementById('products-grid') as HTMLElement;
          if (!grid) return;

          // Show grid, hide empty state
          grid.classList.remove('hidden');
          const emptyState = document.getElementById('products-empty');
          if (emptyState) emptyState.classList.add('hidden');

          // Build a set of IDs currently in DOM
          const existingIds = new Set<string>();
          document.querySelectorAll('[data-product-name]').forEach((card) => {
            const link = card.querySelector('a[href*="/product/"]');
            const href = link?.getAttribute('href') || '';
            const id = href.split('/product/').pop() || '';
            if (id) existingIds.add(id);
          });

          // Hide all existing cards first
          document.querySelectorAll('[data-product-name]').forEach((card) => {
            (card as HTMLElement).style.display = 'none';
          });

          // Show existing ones that match, or create new ones
          const resultIds = products.map((p: any) => p.id);

          // Show matched existing cards
          document.querySelectorAll('[data-product-name]').forEach((card) => {
            const link = card.querySelector('a[href*="/product/"]');
            const href = link?.getAttribute('href') || '';
            const id = href.split('/product/').pop() || '';
            if (resultIds.includes(id)) {
              (card as HTMLElement).style.display = '';
            }
          });

          // For products not in DOM, render them dynamically
          const missingProducts = products.filter((p: any) => !existingIds.has(p.id));
          if (missingProducts.length > 0) {
            const currency = wrapper!.dataset.currency || 'PEN';
            const symbols: Record<string, string> = { PEN: 'S/', USD: '$', EUR: '€', MXN: '$', COP: '$' };
            const symbol = symbols[currency] || currency + ' ';

            missingProducts.forEach((product: any) => {
              const imgUrl = product.images?.[0] || product.image;
              const thumbUrl = imgUrl?.endsWith('.webp') ? imgUrl.replace('.webp', '_md.webp') : imgUrl;
              const productUrl = `/${slug}/product/${product.id}`;
              const html = `
                <article class="bg-white dark:bg-neutral-900 rounded-2xl overflow-hidden border border-gray-100 dark:border-neutral-800 hover:shadow-md transition-shadow" data-product-name="${product.name}" data-search-result="true">
                  <div class="relative">
                    <a href="${productUrl}" class="block">
                      <div class="aspect-square overflow-hidden bg-gray-100 dark:bg-neutral-800 relative">
                        ${thumbUrl
                          ? `<img src="${thumbUrl}" alt="${product.name}" class="w-full h-full object-cover" loading="lazy" />`
                          : `<div class="w-full h-full flex items-center justify-center text-gray-300 dark:text-neutral-600"><svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg></div>`
                        }
                      </div>
                    </a>
                  </div>
                  <div class="p-3">
                    ${product.category ? `<span class="text-xs text-gray-500 dark:text-neutral-500 mb-1 block">${product.category.name}</span>` : ''}
                    <a href="${productUrl}" class="block">
                      <h3 class="font-medium text-gray-900 dark:text-neutral-100 text-sm leading-tight line-clamp-2">${product.name}</h3>
                    </a>
                    <p class="font-bold mt-1" style="color: var(--brand-color)">${symbol}${Number(product.price).toFixed(2)}</p>
                  </div>
                </article>
              `;
              grid.insertAdjacentHTML('beforeend', html);
            });
          }
        } catch {}
      }, 400);
    });

    // Fade edges on scroll
    function updateFade() {
      const el = categories!;
      const scrollLeft = el.scrollLeft;
      const maxScroll = el.scrollWidth - el.clientWidth;

      el.classList.toggle('fade-left', scrollLeft > 4);
      el.classList.toggle('fade-right', scrollLeft < maxScroll - 4);
    }

    categories!.addEventListener('scroll', updateFade);
    updateFade();

    // Scroll active chip into view
    const activeChip = categories!.querySelector('.chip-active') as HTMLElement;
    if (activeChip) {
      activeChip.scrollIntoView({ behavior: 'instant', block: 'nearest', inline: 'center' });
      setTimeout(updateFade, 50);
    }

    // Loading feedback on category click
    categories.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        link.style.opacity = '0.6';
        const text = link.textContent?.trim() || '';
        link.innerHTML = `<svg class="animate-spin w-4 h-4 inline-block mr-1" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>${text}`;
      });
    });
  });
</script>
