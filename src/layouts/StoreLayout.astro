---
import '@/styles/global.css';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  color?: string;
  logo?: string | null;
  ogImage?: string | null;
  canonicalUrl?: string;
  apiUrl?: string;
}

const { title, description, color = '#3499f8', logo, ogImage, canonicalUrl, apiUrl } = Astro.props;

const metaDescription = description || title;
const metaImage = ogImage || logo || null;
const currentUrl = canonicalUrl || Astro.url.href;
const resolvedApiUrl = apiUrl || import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content={color} />
    <meta name="api-url" content={resolvedApiUrl} />

    <!-- Canonical -->
    <link rel="canonical" href={currentUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={currentUrl} />
    {metaImage && <meta property="og:image" content={metaImage} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={metaImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    {metaImage && <meta name="twitter:image" content={metaImage} />}

    <!-- Favicon -->
    {logo ? (
      <link rel="icon" type="image/png" href={logo} />
      <link rel="apple-touch-icon" href={logo} />
    ) : (
      <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    )}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <meta name="view-transition" content="same-origin" />
    <ViewTransitions />
    <title>{title}</title>
    <style define:vars={{ brandColor: color, brandColorDark: color + 'dd' }}>
      :root {
        --brand-color: var(--brandColor);
        --brand-color-dark: var(--brandColorDark);
      }
    </style>
  </head>
  <body class="bg-gray-50 dark:bg-neutral-950 min-h-screen transition-colors">
    <slot />
  </body>
</html>
