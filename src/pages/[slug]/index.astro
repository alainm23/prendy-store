---
import StoreLayout from '@/layouts/StoreLayout.astro';
import Header from '@/components/Header.astro';
import CategoryFilter from '@/components/CategoryFilter.astro';
import ProductGrid from '@/components/ProductGrid.astro';
import Cart from '@/components/Cart.astro';
import Footer from '@/components/Footer.astro';
import { getStoreBySlug, getStoreProducts, getStoreCategories } from '@/lib/api';

const { slug } = Astro.params;
const categoryFilter = Astro.url.searchParams.get('category') || undefined;

const [store, categories, products] = await Promise.all([
  getStoreBySlug(slug!),
  getStoreCategories(slug!),
  getStoreProducts(slug!, categoryFilter),
]);

if (!store) return Astro.redirect('/');

// Adapter para componentes que esperan la estructura plana
const businessView = {
  name: store.business.name,
  description: store.description,
  logo: store.business.logo,
  color: store.business.color || '#3499f8',
  currency: store.business.currency,
  phone: store.business.phone,
  dial_code: store.business.dial_code,
  address: store.branches[0]?.address || null,
  slug: store.slug,
};
---

<StoreLayout title={`${businessView.name} | Catálogo`} description={store.description || undefined} color={businessView.color} logo={businessView.logo} ogImage={businessView.logo}>
  <Header business={businessView} branchCount={store.branches.length} slug={slug} />

  <main class="max-w-6xl mx-auto px-4 py-6">
    <div class="mb-6">
      <CategoryFilter categories={categories} activeCategory={categoryFilter} slug={store.slug} currency={businessView.currency} />
    </div>

    <ProductGrid products={products} currency={businessView.currency} baseUrl={`/${slug}`} hasPhone={!!businessView.phone} showPrices={store.show_prices} />
  </main>

  <Footer instagram={store.instagram} facebook={store.facebook} tiktok={store.tiktok} />

  {businessView.phone && businessView.dial_code && (
    <Cart
      phone={businessView.phone}
      dialCode={businessView.dial_code}
      currency={businessView.currency}
      businessName={businessView.name}
      slug={slug!}
    />
  )}
</StoreLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const slug = window.location.pathname.split('/')[1];
    if (!slug) return;

    // Deduplicate: only track once per session per slug
    const key = `tracked_visit_${slug}`;
    if (sessionStorage.getItem(key)) return;
    sessionStorage.setItem(key, '1');

    const apiUrl = document.querySelector('meta[name="api-url"]')?.getAttribute('content') || '';
    fetch(`${apiUrl}/api/v1/store/${slug}/events`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ type: 'page_view' }),
    }).catch(() => {});
  });
</script>
