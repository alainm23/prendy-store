---
import { Icon } from 'astro-icon/components';
import StoreLayout from '@/layouts/StoreLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { getStoreBySlug } from '@/lib/api';

const { slug } = Astro.params;

const store = await getStoreBySlug(slug!);
if (!store) return Astro.redirect('/');

const businessView = {
  name: store.business.name,
  description: store.description,
  logo: store.business.logo,
  color: store.business.color || '#3499f8',
  currency: store.business.currency,
  phone: store.business.phone,
  dial_code: store.business.dial_code,
  address: store.branches[0]?.address || null,
  slug: store.slug,
};

const dayNames = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'];
const shortDayNames = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];

function formatTime12h(time: string): string {
  const [h, m] = time.split(':').map(Number);
  const period = h >= 12 ? 'PM' : 'AM';
  const hour12 = h === 0 ? 12 : h > 12 ? h - 12 : h;
  return `${hour12}:${m.toString().padStart(2, '0')} ${period}`;
}

function groupSchedule(schedule: any[]) {
  const groups: { days: string[]; hours: string; isOpen: boolean }[] = [];
  schedule.forEach((day: any, index: number) => {
    const label = shortDayNames[index] || `Día ${index + 1}`;
    const hours = day.isOpen
      ? day.ranges?.map((r: any) => `${formatTime12h(r.open)} - ${formatTime12h(r.close)}`).join(', ')
      : 'Cerrado';
    const last = groups[groups.length - 1];
    if (last && last.hours === hours && last.isOpen === day.isOpen) {
      last.days.push(label);
    } else {
      groups.push({ days: [label], hours, isOpen: day.isOpen });
    }
  });
  return groups;
}
---

<StoreLayout title={`Sucursales | ${businessView.name}`} description="Nuestras sucursales y horarios de atención" color={businessView.color} logo={businessView.logo}>
  <Header business={businessView} branchCount={store.branches.length} slug={slug} />

  <main class="max-w-3xl mx-auto px-4 py-6">
    <h2 class="text-xl font-bold text-gray-900 dark:text-neutral-100 mb-4">Sucursales</h2>

    {store.branches.length > 0 ? (
      <div class="flex flex-col gap-4">
        {store.branches.map((branch) => (
          <div class="bg-white dark:bg-neutral-900 rounded-2xl border border-gray-100 dark:border-neutral-800 overflow-hidden">
            {branch.image && (
              <img src={branch.image} alt={branch.name} class="w-full h-40 object-cover" />
            )}
            <div class="p-4">
              <h3 class="font-bold text-gray-900 dark:text-neutral-100 text-lg">{branch.name}</h3>

            <div class="flex flex-col gap-2 mt-3">
              {branch.address && (
                <div class="flex items-center gap-2 text-sm text-gray-600 dark:text-neutral-400">
                  <Icon name="lucide:map-pin" class="w-4 h-4 shrink-0" />
                  <span>{branch.address}</span>
                </div>
              )}

              {branch.phone && (
                <div class="flex items-center gap-2 text-sm text-gray-600 dark:text-neutral-400">
                  <Icon name="lucide:phone" class="w-4 h-4 shrink-0" />
                  <a href={`tel:${branch.phone}`} class="hover:underline">{branch.phone}</a>
                </div>
              )}

              {branch.location && (
                <div class="flex items-center gap-2 text-sm text-gray-600 dark:text-neutral-400">
                  <Icon name="lucide:navigation" class="w-4 h-4 shrink-0" />
                  <a
                    href={`https://www.google.com/maps?q=${branch.location}`}
                    target="_blank"
                    rel="noopener"
                    class="hover:underline" style="color: var(--brand-color)"
                  >
                    Ver en mapa
                  </a>
                </div>
              )}
            </div>

            {branch.schedule && branch.schedule.length > 0 && (
              <div class="mt-4 pt-4 border-t border-gray-100 dark:border-neutral-800">
                <div class="flex items-center gap-2 mb-3">
                  <Icon name="lucide:clock" class="w-4 h-4 text-gray-500 dark:text-neutral-400" />
                  <p class="text-sm font-semibold text-gray-700 dark:text-neutral-300 m-0">Horario de atención</p>
                </div>
                <div class="flex flex-col gap-2">
                  {groupSchedule(branch.schedule).map((group) => (
                    <div class="py-2 px-3 rounded-lg bg-gray-50 dark:bg-neutral-800/50">
                      <span class="text-sm font-medium" style="color: var(--brand-color)">
                        {group.days.length > 1
                          ? `${group.days[0]} - ${group.days[group.days.length - 1]}`
                          : group.days[0]}
                      </span>
                      {group.isOpen ? (
                        <div class="flex flex-col gap-0.5 mt-1">
                          {group.hours.split(', ').map((range) => (
                            <span class="text-sm text-gray-900 dark:text-neutral-100">{range}</span>
                          ))}
                        </div>
                      ) : (
                        <p class="text-sm text-red-500 dark:text-red-400 mt-1 m-0">Cerrado</p>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            )}
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <p class="text-gray-400 dark:text-neutral-500 text-lg">No hay sucursales disponibles</p>
      </div>
    )}
  </main>

  <Footer instagram={store.instagram} facebook={store.facebook} tiktok={store.tiktok} />
</StoreLayout>
