---
import { Icon } from 'astro-icon/components';
import StoreLayout from '@/layouts/StoreLayout.astro';
import Header from '@/components/Header.astro';
import Cart from '@/components/Cart.astro';
import Footer from '@/components/Footer.astro';
import { getStoreBySlug, getStoreProductDetail, formatPrice } from '@/lib/api';

const { slug, id } = Astro.params;

const [store, product] = await Promise.all([
  getStoreBySlug(slug!),
  getStoreProductDetail(slug!, id!),
]);

if (!store) return Astro.redirect('/');
if (!product) {
  return new Response('Producto no encontrado', { status: 404 });
}

const businessView = {
  name: store.business.name,
  description: store.description,
  logo: store.business.logo,
  color: store.business.color || '#3499f8',
  currency: store.business.currency,
  phone: store.business.phone,
  dial_code: store.business.dial_code,
  address: store.branches[0]?.address || null,
  slug: store.slug,
};

const imageUrl = product.images?.[0] || product.image || null;
const productImages = product.images || (product.image ? [product.image] : []);
---

<StoreLayout title={`${product.name} | ${businessView.name}`} description={product.description} color={businessView.color} logo={businessView.logo} ogImage={imageUrl}>
  <Header business={businessView} slug={slug} />

  <main class="max-w-3xl mx-auto px-4 py-6">
    <div class="bg-white dark:bg-neutral-900 rounded-2xl border border-gray-100 dark:border-neutral-800 overflow-hidden">
      <!-- Imagen / Galería -->
      <div class="relative">
        {productImages.length > 1 ? (
          <div class="gallery-container">
            <div class="gallery-track" id="gallery-track">
              {productImages.map((img, i) => (
                <div class="gallery-slide aspect-square bg-gray-100 dark:bg-neutral-800">
                  <img src={img} alt={`${product.name} - ${i + 1}`} class="w-full h-full object-cover" style={i === 0 ? `view-transition-name: product-img-${product.id}` : undefined} />
                </div>
              ))}
            </div>
            <div class="gallery-thumbs" id="gallery-thumbs">
              {productImages.map((img, i) => (
                <button class:list={['thumb', i === 0 && 'active']} data-index={i}>
                  <img src={img} alt={`Miniatura ${i + 1}`} class="w-full h-full object-cover" />
                </button>
              ))}
            </div>
          </div>
        ) : (
          <div class="aspect-square bg-gray-100 dark:bg-neutral-800">
            {imageUrl ? (
              <img src={imageUrl} alt={product.name} class="w-full h-full object-cover" style={`view-transition-name: product-img-${product.id}`} />
            ) : (
              <div class="w-full h-full flex items-center justify-center text-gray-300 dark:text-neutral-600">
                <Icon name="lucide:package" class="w-20 h-20" />
              </div>
            )}
          </div>
        )}
      </div>

      <!-- Info -->
      <div class="p-5">
        {product.category && (
          <span class="text-sm text-gray-500 dark:text-neutral-500 mb-1 block">{product.category.name}</span>
        )}
        <h1 class="text-xl font-bold text-gray-900 dark:text-neutral-100">{product.name}</h1>
        {store.show_prices && (
          <p class="text-2xl font-bold mt-2" style="color: var(--brand-color)">
            {formatPrice(product.price, businessView.currency)}
          </p>
        )}

        {product.description && (
          <p class="text-gray-600 dark:text-neutral-400 mt-4 leading-relaxed">{product.description}</p>
        )}

        {businessView.phone && (
          <button
            class="add-to-cart mt-6 w-full py-3 px-4 text-base font-medium rounded-xl transition-colors border"
            style="background-color: color-mix(in srgb, var(--brand-color) 12%, transparent); border-color: color-mix(in srgb, var(--brand-color) 40%, transparent); color: var(--brand-color)"
            data-id={product.id}
            data-name={product.name}
            data-price={product.price}
            data-sku={product.sku || ''}
            data-image={imageUrl || ''}
          >
            Agregar al pedido
          </button>
        )}

        <button
          id="share-btn"
          class="mt-3 w-full py-3 px-4 bg-gray-100 dark:bg-neutral-800 text-gray-700 dark:text-neutral-300 text-base font-medium rounded-xl border border-gray-200 dark:border-neutral-700 hover:bg-gray-200 dark:hover:bg-neutral-700 transition-colors flex items-center justify-center gap-2"
          data-title={product.name}
          data-text={`Mira este producto: ${product.name}`}
        >
          <Icon name="lucide:share-2" class="w-5 h-5" />
          Compartir
        </button>
      </div>
    </div>
  </main>

  <Footer />

  <Cart
    phone={businessView.phone!}
    dialCode={businessView.dial_code!}
    currency={businessView.currency}
    businessName={businessView.name}
    slug={slug!}
  />
</StoreLayout>

<script>
  // Gallery slider
  const track = document.getElementById('gallery-track');
  const thumbs = document.querySelectorAll('#gallery-thumbs .thumb');

  if (track && thumbs.length > 0) {
    let currentIndex = 0;

    track.addEventListener('scroll', () => {
      const slideWidth = track.offsetWidth;
      const newIndex = Math.round(track.scrollLeft / slideWidth);
      if (newIndex !== currentIndex) {
        currentIndex = newIndex;
        thumbs.forEach((thumb, i) => {
          thumb.classList.toggle('active', i === currentIndex);
        });
      }
    });

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const index = Number((thumb as HTMLElement).dataset.index);
        track.scrollTo({ left: index * track.offsetWidth, behavior: 'smooth' });
      });
    });
  }

  // Share button
  const shareBtn = document.getElementById('share-btn');

  shareBtn?.addEventListener('click', async () => {
    const title = shareBtn.dataset.title || '';
    const text = shareBtn.dataset.text || '';
    const url = window.location.href;

    if (navigator.share) {
      try {
        await navigator.share({ title, text, url });
      } catch {
        // Usuario canceló
      }
    } else {
      await navigator.clipboard.writeText(url);
      shareBtn.innerHTML = `
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
        ¡Enlace copiado!
      `;
      setTimeout(() => {
        shareBtn.innerHTML = `
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
          </svg>
          Compartir
        `;
      }, 2000);
    }
  });
</script>

<style>
  .gallery-container {
    position: relative;
  }

  .gallery-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .gallery-track::-webkit-scrollbar {
    display: none;
  }

  .gallery-slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }

  .gallery-thumbs {
    display: flex;
    gap: 8px;
    padding: 12px 16px;
  }

  .gallery-thumbs .thumb {
    width: 56px;
    height: 56px;
    border-radius: 10px;
    overflow: hidden;
    border: 2px solid transparent;
    opacity: 0.5;
    transition: all 0.2s ease;
    cursor: pointer;
    padding: 0;
    background: none;
  }

  .gallery-thumbs .thumb.active {
    border-color: var(--brand-color);
    opacity: 1;
  }

  .gallery-thumbs .thumb:hover {
    opacity: 0.8;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const pathParts = window.location.pathname.split('/');
    const slug = pathParts[1];
    const productId = pathParts[3]; // /{slug}/product/{id}
    if (!slug || !productId) return;

    // Deduplicate: only track once per session per product
    const key = `tracked_product_${productId}`;
    if (sessionStorage.getItem(key)) return;
    sessionStorage.setItem(key, '1');

    const apiUrl = document.querySelector('meta[name="api-url"]')?.getAttribute('content') || '';
    fetch(`${apiUrl}/api/v1/store/${slug}/events`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ type: 'product_view', product_id: productId }),
    }).catch(() => {});
  });
</script>
